IF OBJECT_ID('mlb.dbo.dim_venue_weather', 'U') IS NOT NULL
    DROP TABLE mlb.dbo.dim_venue_weather;

CREATE TABLE mlb.dbo.dim_venue_weather (
    venue_id        INT           NOT NULL PRIMARY KEY,
    venue_name      VARCHAR(150)  NOT NULL,
    latitude        DECIMAL(9,6)  NOT NULL,
    longitude       DECIMAL(9,6)  NOT NULL,
    elevation_m     INT           NULL,
    roof_type       VARCHAR(20)   NULL  -- outdoor, dome, retractable
);


